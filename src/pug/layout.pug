doctype html
html(lang='ru')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    // Блок для установки переменных, таких как 'title'
    block variables 
    title Салон-парикмахерская Noodle | #{title}
    
    // Правильное подключение стилей в секции head
    link(rel='stylesheet', href='/css/style.css')
  body
    header.header
      .container
        h1.logo Noodle
        nav.nav
          ul
            // Ссылки на скомпилированные HTML-файлы
            li: a(href='/index.html') Главная
            li: a(href='#services') Услуги
            li: a(href='/booking.html').btn.btn-primary Записаться онлайн
    
    main.main
      // Блок, который будут заполнять дочерние шаблоны
      block content 
      
    footer.footer
      .container
        p &copy; 2025 Салон Noodle. Все права защищены.
        .footer-contacts
          a(href='#') Контакты
          span |
          a(href='#') Политика конфиденциальности
          
    // Подключение jQuery
    script(src='https://code.jquery.com/jquery-3.6.0.min.js')
    // Подключение основного скрипта
    script(src='/js/app.js')