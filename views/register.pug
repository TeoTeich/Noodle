extends layout

block content
    .auth-form
        h2 Регистрация нового клиента
        if error
            .error-message= error
            
        form(action='/register', method='POST')
            .form-group
                label(for='name') Имя
                input#name(type='text', name='name', required)
            .form-group
                label(for='username') Логин (Username)
                input#username(type='text', name='username', required)
            .form-group
                label(for='phone') Телефон
                input#phone(type='text', name='phone', required)
            .form-group
                label(for='password') Пароль
                input#password(type='password', name='password', required)
            
            button.button.primary(type='submit') Зарегистрироваться
        
        p Уже есть аккаунт? 
            a(href='/login') Войти