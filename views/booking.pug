extends layout.pug 
block variables
  - var title = 'Онлайн-запись'

block content
  section.booking-form-section
    .container
      h2.section-title Запись на услуги в "Noodle"
      p Выберите услугу, мастера и удобное для вас время.
      p Вы записываетесь как #[strong #{username}].
      
      form#booking-form.booking-form(method='POST')
        .form-group
          label(for='service-select') Выберите услугу:
          select#service-select(name='service', required, disabled)
            option(value='') -- Загрузка услуг... --
        
        .form-group
          label(for='master-select') Выберите мастера:
          select#master-select(name='master', required, disabled)
            option(value='') -- Выберите мастера --
            
        .form-group
          label(for='booking-date') Выберите дату:
          input#booking-date(type='date', name='date', required, disabled)
          
        .form-group
          label Время записи:
          .time-slots#time-slots
            p.info-text Выберите дату, чтобы увидеть свободное время.
          
        button.btn.btn-lg.btn-primary(type='submit', disabled)#submit-booking
          | Записаться
          
      #status-message.hidden(aria-live='polite')

block append scripts
    // 1. Общие API функции
    script(src='/js/api.js') 
    // 2. Клиентская логика
    script(src='/js/app.js')