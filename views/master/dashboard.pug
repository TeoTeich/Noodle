extends ../layout

block content
    .container
        h2 Кабинет Мастера: #{user.name || user.username}
        
        if message
            .success-message= message
        if error
            .error-message= error

        // --- ФОРМА ФИЛЬТРАЦИИ И СОРТИРОВКИ ---
        .filter-sort-controls 
            h3 🔎 Фильтр и Сортировка 
            
            form(action='/master/dashboard', method='GET', class='filter-form')
                // Поле: Фильтр по дате
                .form-group(style='flex-grow: 1;')
                    label(for='filter_date') Дата
                    input#filter_date(type='date', name='date', value=filterDate || '', style='max-width: 100%;')

                // Поле: Фильтр по клиенту
                .form-group(style='flex-grow: 1;')
                    label(for='filter_client') Имя клиента (поиск)
                    input#filter_client(type='text', name='clientName', value=filterClientName || '', style='max-width: 100%;')
                
                // Выпадающий список для сортировки
                .form-group(style='width: 180px;')
                    label(for='sort') Сортировка
                    select#sort(name='sort', style='max-width: 100%;')
                        option(value='date_asc', selected=currentSort === 'date_asc') Ближайшая дата
                        option(value='date_desc', selected=currentSort === 'date_desc') Самая дальняя дата
                        option(value='client_asc', selected=currentSort === 'client_asc') Клиент (А-Я)

                // Кнопки (применяем новый класс для отступа)
                .form-group.filter-button-group
                    button.button(type='submit') Применить

                // Кнопка сброса (перезагружает страницу без параметров)
                .form-group.filter-button-group
                    a.button.warning(href='/master/dashboard') Сброс
            
        
        p Ваши предстоящие записи (только "Запланировано" и "Подтверждено").
        if bookings && bookings.length
            .booking-list.column-list
                each booking in bookings
                    .booking-card
                        h3.card-title Запись №#{booking.booking_id}
                        p 
                            | Дата: #{booking.booking_date} в #{booking.booking_time} 
                            span(style='margin-left: 10px;').duration-text (#{booking.duration_min} мин.)
                        p Услуга: #{booking.service_name}
                        p Клиент: **#{booking.client_name}** (#{booking.client_phone})
                        
                        p Статус: 
                            span(class=`status-${booking.status.toLowerCase().replace(/[^a-zа-яё]/g, '')}`) #{booking.status}
                        
                        .status-actions
                            if booking.status === 'Запланировано'
                                form(action=`/master/booking/status/${booking.booking_id}`, method='POST', class='inline-form')
                                    input(type='hidden', name='newStatus', value='Подтверждено')
                                    button.button.small.success(type='submit') Подтвердить
                            
                            if booking.status !== 'Завершено'
                                form(action=`/master/booking/status/${booking.booking_id}`, method='POST', class='inline-form')
                                    input(type='hidden', name='newStatus', value='Завершено')
                                    button.button.small.warning(type='submit') Завершить
                                
                                form(action=`/master/booking/status/${booking.booking_id}`, method='POST', class='inline-form')
                                    input(type='hidden', name='newStatus', value='Отменено')
                                    button.button.small.danger(type='submit', onclick="return confirm('Вы уверены, что хотите отменить эту запись?')") Отменить
        else
            p.info-message В настоящее время у вас нет предстоящих записей.