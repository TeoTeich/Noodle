extends layout

block content
    .container
        h1 Добро пожаловать в Noodle
        p Выберите услугу и запишитесь к мастеру!

        if message
            .success-message= message
        if error
            .error-message= error

        h2 Наши услуги

        if services && services.length
            .service-list
                each service in services
                    .service-card
                        h3(style='color: var(--color-secondary);') #{service.name}
                        p.
                            #{service.description}
                        
                        p(style='font-weight: bold;') Цена: #{service.price} руб.
                        p.
                            Длительность: #{service.duration_min} мин.
                        
                        // Кнопка, ведущая на форму записи
                        a.button.primary(href=`/client/book?serviceId=${service.id}`)  Записаться
        else
            p В настоящее время нет доступных услуг.