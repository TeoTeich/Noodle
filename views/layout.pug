doctype html
html(lang='ru')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    block variables 
    title Салон-парикмахерская Noodle | #{title}
    
    link(rel='stylesheet', href='/css/style.css')
    
    // 1. jQuery должен загружаться здесь или первым в блоке scripts
    script(src='https://code.jquery.com/jquery-3.6.0.min.js') 
    
  body
    header.header
      .container
        h1.logo Noodle
        nav.nav
          ul
            li: a(href='/index.html') Главная
            li: a(href='#services') Услуги
            
            // --- УСЛОВНАЯ ССЫЛКА НА КАБИНЕТ ---
            if role === 'client'
              li: a(href='/my_bookings.html') Мои записи
            else if role === 'master'
              li: a(href='/master_cabinet.html') Кабинет Мастера
            else if role === 'admin'
              li: a(href='/admin.html') Панель Администратора
            // ----------------------------------
              
            li: a(href='/booking.html').btn.btn-primary Записаться
            
            if !isLoggedIn
              li: a(href='/register.html') Регистрация
              li: a(href='/login.html') Вход 
            else
              li: a(href='/api/logout') Выход

    main.main
      block content 
      
    footer.footer
      .container
        p &copy; 2025 Салон Noodle. Все права защищены.
        .footer-contacts
          a(href='#') Контакты
          span |
          a(href='#') Политика конфиденциальности

    // 2. Блок scripts для пользовательских скриптов
    block scripts 
    script(src='/js/app.js')
    script(src='/js/auth.js') 
    script(src='/js/schedule.js')