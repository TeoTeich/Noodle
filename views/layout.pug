doctype html
html(lang='ru')
    head
        meta(charset='UTF-8')
        meta(name='viewport', content='width=device-width, initial-scale=1.0')
        title #{title} | Noodle Salon
        link(rel='stylesheet', href='/css/style.css')
    body
        header
            nav.navbar
                a.logo(href='/') Noodle Salon
                .nav-links
                    if user
                        span.nav-user Привет, #{user.name || user.username}!
                        a(href='/' + user.role + '/dashboard') Кабинет
                        form(action='/logout', method='POST', style='display:inline;')
                            button.button(type='submit') Выход
                    else
                        a(href='/login') Вход
                        a(href='/register') Регистрация
        
        block content