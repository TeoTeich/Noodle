doctype html
html(lang='ru')
    head
        meta(charset='UTF-8')
        meta(name='viewport', content='width=device-width, initial-scale=1.0')
        title #{title} | Noodle Salon
        link(rel='stylesheet', href='/css/style.css') 
        // Временно простой CSS для визуальной проверки
        style.
            body { font-family: Arial, sans-serif; margin: 0; padding-top: 60px; background: #f4f4f9; }
            .navbar { background: #333; color: white; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; position: fixed; top: 0; width: 100%; z-index: 100; }
            .logo { color: white; text-decoration: none; font-size: 1.5em; font-weight: bold; }
            .nav-links a, .nav-links button { color: white; text-decoration: none; margin-left: 15px; background: none; border: none; cursor: pointer; font-size: 1em; }
            .nav-user { margin-right: 15px; }
            .container { width: 90%; max-width: 800px; margin: 40px auto; padding: 20px; background: white; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
            .auth-form { max-width: 400px; margin: 50px auto; padding: 20px; border: 1px solid #ccc; border-radius: 5px; background: #fff; }
            .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
            .form-group input { width: 100%; padding: 10px; margin-bottom: 20px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
            button[type="submit"] { background: #5cb85c; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; }
            .error-message { color: red; margin-bottom: 20px; padding: 10px; border: 1px solid red; background: #ffe0e0; border-radius: 4px; }
    body
        header
            nav.navbar
                a.logo(href='/') Noodle Salon
                .nav-links
                    if user
                        span.nav-user Привет, #{user.name || user.username}!
                        a(href='/' + user.role + '/dashboard') Кабинет
                        form(action='/logout', method='POST', style='display:inline;')
                            button(type='submit') Выход
                    else
                        a(href='/register') Регистрация
                        a(href='/login') Вход
        
        main
            block content
        
        footer
            p(style='text-align:center; padding: 20px; color: #777;') &copy; #{new Date().getFullYear()} Noodle Salon