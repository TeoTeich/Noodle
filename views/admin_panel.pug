extends layout.pug 
block variables
    - var title = 'Панель Администратора'
    
block content
    .container
        h1.section-title Панель Администратора
        h2 Запись клиента
        #message-area.alert(style='display: none;')
        form#booking-form(action='/api/booking', method='POST')
            .form-group
                label(for='client-user-id') Выберите Клиента
                select#client-user-id.form-control(name='clientUserId', required, disabled)
                    option(value='') Загрузка клиентов...

            .form-group
                label(for='service-select') Услуга
                select#service-select.form-control(name='serviceId', required, disabled)
                    option(value='') Загрузка услуг...

            .form-group
                label(for='master-select') Мастер
                select#master-select.form-control(name='masterId', required, disabled)
                    option(value='') Сначала выберите услугу

            .form-group
                label(for='date-input') Дата
                input#date-input.form-control(type='date', name='date', required, disabled)

            .form-group
                label(for='time-select') Время
                select#time-select.form-control(name='time', required, disabled)
                    option(value='') Сначала выберите мастера и дату

            button.btn.btn-primary(type='submit') Записать клиента
        
        hr
        h2.mt-5 Записи всех мастеров
        #bookings-list
            p.info-text Загрузка всех записей...

block append scripts
    script(src='/js/api.js') // 1. Общие функции должны быть первыми
    script(src='/js/schedule.js') // 2. Логика для списка записей (содержит loadBookings)
    script(src='/js/admin.js') // 3. Логика формы админа