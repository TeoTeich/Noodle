extends ../layout

block content
    .container
        h2 Ваш личный кабинет
        
        if message
            .success-message= message
        if error
            .error-message= error

        h3 Ваши записи
        
        // --- БЕЗОПАСНАЯ ПРОВЕРКА ДЛЯ ФИЛЬТРАЦИИ ---
        - const clientCurrentStatus = (typeof filter !== 'undefined' && filter) ? filter.status : '';
        - const clientCurrentSort = (typeof filter !== 'undefined' && filter) ? filter.sort : 'asc';
        
        // --- ФОРМА ФИЛЬТРАЦИИ И СОРТИРОВКИ ЗАПИСЕЙ ---
        .filter-sort-controls
            h4 Фильтрация и сортировка записей
            form.filter-form(action='/client/dashboard', method='GET')
                .form-group
                    label(for='status-filter') Статус
                    select#status-filter(name='status')
                        option(value='', selected=clientCurrentStatus === '') Все статусы
                        option(value='Запланировано', selected=clientCurrentStatus === 'Запланировано') Запланировано
                        option(value='Подтверждено', selected=clientCurrentStatus === 'Подтверждено') Подтверждено
                        option(value='Завершено', selected=clientCurrentStatus === 'Завершено') Завершено
                        option(value='Отменено', selected=clientCurrentStatus === 'Отменено') Отменено
                .form-group
                    label(for='date-sort') Сортировать по дате
                    select#date-sort(name='sort')
                        option(value='asc', selected=clientCurrentSort === 'asc') Сначала старые
                        option(value='desc', selected=clientCurrentSort === 'desc') Сначала новые
                .form-group(style='padding-top: 5px;')
                    button.button.primary(type='submit') Применить

        // --- БЛОК ОТОБРАЖЕНИЯ ЗАПИСЕЙ ---
        if bookings && bookings.length
            .booking-list
                each booking in bookings
                    .booking-card
                        h4(style='margin-top: 0; color: var(--color-primary);') #{booking.service_name}

                        .details
                            p(style='margin: 5px 0;')
                                strong Статус: 
                                span(style=`color: ${booking.status === 'Отменено' ? 'var(--color-danger)' : (booking.status === 'Завершено' ? 'var(--color-success)' : 'var(--color-warning)')}; font-weight: bold;`) #{booking.status}
                            p(style='margin: 5px 0;')
                                strong Дата и время: 
                                | #{booking.booking_date} в #{booking.booking_time} 
                                span(style='font-size: 0.9em; color: #666;') (#{booking.duration_min} мин)
                            p(style='margin: 5px 0;')
                                strong Мастер: 
                                | #{booking.master_name || 'Не назначен'}

                        // --- ДЕЙСТВИЯ: Отмена и Перенос ---
                        - const isEditable = booking.status === 'Запланировано' || booking.status === 'Подтверждено'

                        if isEditable
                            .booking-actions(style='margin-top: 15px; padding-top: 15px; border-top: 1px dashed #eee;')

                                // Форма Переноса
                                form(action=`/client/booking/reschedule/${booking.booking_id}`, method='POST', style='display: block; margin-bottom: 10px; border: 1px solid var(--color-warning); padding: 10px; border-radius: var(--border-radius);')
                                    p(style='margin-top: 0; font-weight: bold; color: var(--color-warning);') Перенос записи:

                                    .form-group(style='display: inline-block; width: 150px; margin-right: 10px;')
                                        label(for=`newDate-${booking.booking_id}`) Новая дата
                                        input.input.small(type='date', name='newDate', required, id=`newDate-${booking.booking_id}`, min=new Date().toISOString().split('T')[0])

                                    .form-group(style='display: inline-block; width: 120px; margin-right: 10px;')
                                        label(for=`newTime-${booking.booking_id}`) Новое время
                                        input.input.small(type='time', name='newTime', required, id=`newTime-${booking.booking_id}`, value=booking.booking_time)
                                    .form-group(style='display: inline-block; vertical-align: top; padding-top: 25px;')
                                        button.button.small.warning(type='submit') Перенести
                                        
                                // Кнопка Отмены
                                form(action=`/client/booking/cancel/${booking.booking_id}`, method='POST', style='display:inline;')
                                    button.button.small.danger(type='submit', onclick="return confirm('Вы уверены, что хотите отменить эту запись?')") Отменить запись
        else
            .card
                p У вас пока нет запланированных записей. 
                a.button.primary(href='/') Записаться на услугу