extends ../layout

block content
    .container
        h2 Административная панель
        
        if message
            .success-message= message
        if error
            .error-message= error

        p Вы успешно авторизованы как #{user.role}.

        .card
            h3 Меню
            ul(style='list-style: none; padding: 0; display: flex; gap: 20px;')
                li: a.button.primary(href='/admin/services') Управление Услугами
                li: a.button.primary(href='/admin/masters') Управление Мастерами
                // Можно добавить ссылки на управление пользователями