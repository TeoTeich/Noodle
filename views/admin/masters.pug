extends ../layout

block content
    .container
        h2 Управление Мастерами
        
        if message
            .success-message= message
        if error
            .error-message= error
            
        // ----------------------------------------
        // 1. ФОРМА ДОБАВЛЕНИЯ МАСТЕРА
        // ----------------------------------------
        .card
            h3 Добавить нового мастера (повысить роль)
            p.note Введите логин !уже существующего! пользователя, чтобы назначить его мастером.
            form(action='/admin/masters/add', method='POST')
                .form-group
                    label(for='username') Логин пользователя (Username)
                    input#username(type='text', name='username', required)
                .form-group
                    label(for='specialization') Специализация
                    input#specialization(type='text', name='specialization', required)

                button.button.primary(type='submit') Назначить Мастером

        // ----------------------------------------
        // 3. СПИСОК МАСТЕРОВ
        // ----------------------------------------
        .card
            h3 Список всех мастеров
            table.data-table
                thead
                    tr
                        th ID Мастера
                        th Имя
                        th Логин
                        th Телефон
                        th Специализация
                        th Действия
                tbody
                    if masters && masters.length
                        each master in masters
                            - const modalId = 'editMasterModal' + master.master_id
                            tr
                                td= master.master_id
                                td= master.name || '(Не указано)'
                                td= master.username
                                td= master.phone || '(Не указан)'
                                td= master.specialization
                                td
                                    // Кнопка, открывающая модальное окно редактирования
                                    button.button.small.warning(onclick=`document.getElementById('${modalId}').style.display='block'`) Редактировать

                                    // Форма для удаления
                                    form(action=`/admin/masters/delete/${master.master_id}`, method='POST', style='display:inline;')
                                        button.button.small.danger(type='submit', onclick="return confirm('Вы уверены, что хотите удалить этого мастера? Пользователь будет переведен в клиенты.')") Удалить
                            
                            // МОДАЛЬНОЕ ОКНО РЕДАКТИРОВАНИЯ МАСТЕРА
                            .modal(id=modalId)
                                .modal-content
                                    span.close(onclick=`document.getElementById('${modalId}').style.display='none'`) &times;
                                    h4 Редактировать мастера: #{master.username}
                                    form(action=`/admin/masters/edit/${master.master_id}`, method='POST')
                                        p(style='font-weight: bold;') Имя: #{master.name}
                                        p(style='font-weight: bold;') Логин: #{master.username}
                                        .form-group
                                            label(for='edit_specialization') Специализация
                                            input#edit_specialization(type='text', name='specialization', value=master.specialization, required)
                                        
                                        button.button.primary(type='submit') Сохранить
                    else
                        tr
                            td(colspan='6') Мастера не найдены.