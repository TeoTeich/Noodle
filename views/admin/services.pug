extends ../layout

block content
    .container
        h2 Управление Услугами
        
        if message
            .success-message(style='padding: 10px; background: #d4edda; color: #155724; border: 1px solid #c3e6cb; margin-bottom: 20px;')= message
        if error
            .error-message(style='padding: 10px; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; margin-bottom: 20px;')= error

        // ----------------------------------------
        // 1. ФОРМА ДОБАВЛЕНИЯ УСЛУГИ
        // ----------------------------------------
        .card(style='margin-bottom: 30px; padding: 20px; border: 1px solid #ddd; border-radius: 5px;')
            h3 Добавить новую услугу
            form(action='/admin/services/add', method='POST')
                .form-group
                    label(for='name') Название
                    input#name(type='text', name='name', required)
                .form-group
                    label(for='price') Цена (руб.)
                    input#price(type='number', name='price', step='0.01', min='0', required)
                .form-group
                    label(for='duration_min') Длительность (мин.)
                    input#duration_min(type='number', name='duration_min', min='1', required)

                .form-group
                    label Мастера, выполняющие услугу
                    if masters && masters.length
                        div(style='display: flex; flex-wrap: wrap; gap: 15px;')
                            each master in masters
                                label.checkbox-label(style='display: flex; align-items: center; cursor: pointer;')
                                    input(type='checkbox', name='master_ids', value=master.id, style='margin-right: 5px;')
                                    span= master.name
                    else
                        p Нет доступных мастеров. Добавьте мастеров в систему.
                
                button.button(type='submit', style='background: #3498db; color: white;') Сохранить Услугу

        // ----------------------------------------
        // 2. СПИСОК УСЛУГ (R - Read / U - Update / D - Delete)
        // ----------------------------------------
        .card
            h3 Список всех услуг
            table.data-table(style='width: 100%; border-collapse: collapse; margin-top: 20px;')
                thead
                    tr
                        th(style='border: 1px solid #ddd; padding: 8px; text-align: left;') ID
                        th(style='border: 1px solid #ddd; padding: 8px; text-align: left;') Название
                        th(style='border: 1px solid #ddd; padding: 8px; text-align: left;') Цена
                        th(style='border: 1px solid #ddd; padding: 8px; text-align: left;') Длит. (мин)
                        th(style='border: 1px solid #ddd; padding: 8px; text-align: left;') Мастера
                        th(style='border: 1px solid #ddd; padding: 8px; text-align: left;') Действия
                tbody
                    each service in services
                        // Используем ID услуги как часть ID для модального окна
                        - const modalId = 'editModal' + service.id
                        tr
                            td(style='border: 1px solid #ddd; padding: 8px;')= service.id
                            td(style='border: 1px solid #ddd; padding: 8px;')= service.name
                            td(style='border: 1px solid #ddd; padding: 8px;')= service.price
                            td(style='border: 1px solid #ddd; padding: 8px;')= service.duration_min
                            // Отображение имен мастеров
                            td(style='border: 1px solid #ddd; padding: 8px;')
                                -
                                    const assignedMasterNames = masters
                                        .filter(m => service.masterIds.includes(m.id))
                                        .map(m => m.name)
                                        .join(', ');
                                if assignedMasterNames
                                    | #{assignedMasterNames}
                                else
                                    | (Нет)
                            td(style='border: 1px solid #ddd; padding: 8px;')
                                // Кнопка, открывающая модальное окно редактирования
                                button.button.small(onclick=`document.getElementById('${modalId}').style.display='block'`, style='margin-right: 5px; background: #f39c12; color: white;') Редактировать
                                
                                // Форма для удаления
                                form(action=`/admin/services/delete/${service.id}`, method='POST', style='display:inline;')
                                    button.button.small.danger(type='submit', onclick="return confirm('Вы уверены, что хотите удалить эту услугу?')", style='background: #e74c3c; color: white;') Удалить

                        // ----------------------------------------
                        // МОДАЛЬНОЕ ОКНО РЕДАКТИРОВАНИЯ (U - Update)
                        // ----------------------------------------
                        .modal(id=modalId, style='display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.4);')
                            .modal-content(style='background-color: #fefefe; margin: 10% auto; padding: 20px; border: 1px solid #888; width: 80%; max-width: 500px;')
                                span.close(onclick=`document.getElementById('${modalId}').style.display='none'`, style='color: #aaa; float: right; font-size: 28px; font-weight: bold; cursor: pointer;') &times;
                                h4 Редактировать услугу: #{service.name}

                                form(action=`/admin/services/edit/${service.id}`, method='POST')
                                    .form-group
                                        label(for=`name-${service.id}`) Название
                                        input(type='text', name='name', value=service.name, required, id=`name-${service.id}`)
                                    .form-group
                                        label(for=`price-${service.id}`) Цена (руб.)
                                        input(type='number', name='price', step='0.01', min='0', value=service.price, required, id=`price-${service.id}`)
                                    .form-group
                                        label(for=`duration-${service.id}`) Длительность (мин.)
                                        input(type='number', name='duration_min', min='1', value=service.duration_min, required, id=`duration-${service.id}`)
                                    
                                    .form-group
                                        label Мастера
                                        div(style='display: flex; flex-wrap: wrap; gap: 15px;')
                                            each master in masters
                                                - const isChecked = service.masterIds.includes(master.id)
                                                label.checkbox-label(style='display: flex; align-items: center; cursor: pointer;')
                                                    input(type='checkbox', name='master_ids', value=master.id, checked=isChecked, style='margin-right: 5px;')
                                                    span= master.name

                                    button.button(type='submit') Сохранить изменения