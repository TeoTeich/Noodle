extends ../layout

block content
    .container
        h2 Управление Услугами

        if message
            .success-message= message
        if error
            .error-message= error
            
        // ----------------------------------------
        // 1. ФОРМА ДОБАВЛЕНИЯ УСЛУГИ
        // ----------------------------------------
        .card
            h3 Добавить новую услугу
            form(action='/admin/services/add', method='POST')
                .form-group
                    label(for='name') Название услуги
                    input#name(type='text', name='name', required)
                .form-group
                    label(for='description') Описание
                    input#description(type='text', name='description', required)
                .form-group
                    label(for='price') Цена (руб.)
                    input#price(type='number', name='price', required, min='0')
                .form-group
                    label(for='duration_min') Длительность (мин.)
                    input#duration_min(type='number', name='duration_min', required, min='10')

                button.button.primary(type='submit') Добавить Услугу

        // ----------------------------------------
        // 2. СПИСОК УСЛУГ
        // ----------------------------------------
        .card
            h3 Список всех услуг
            table.data-table
                thead
                    tr
                        th ID Услуги
                        th Название
                        th Цена
                        th Длительность (мин)
                        th Действия
                tbody
                    if services && services.length
                        each service in services
                            - const modalId = 'editServiceModal' + service.service_id
                            tr
                                td= service.service_id
                                td= service.name
                                td= service.price
                                td= service.duration_min
                                td
                                    // Кнопка, открывающая модальное окно редактирования
                                    button.button.small.warning(onclick=`document.getElementById('${modalId}').style.display='block'`) Редактировать

                                    // Форма для удаления
                                    form(action=`/admin/services/delete/${service.service_id}`, method='POST', style='display:inline;')
                                        button.button.small.danger(type='submit', onclick="return confirm('Вы уверены, что хотите удалить эту услугу?')") Удалить
                            
                            // ----------------------------------------
                            // МОДАЛЬНОЕ ОКНО РЕДАКТИРОВАНИЯ УСЛУГИ
                            // ----------------------------------------
                            .modal(id=modalId)
                                .modal-content
                                    span.close(onclick=`document.getElementById('${modalId}').style.display='none'`) &times;
                                    h4 Редактировать услугу: #{service.name}
                                    form(action=`/admin/services/edit/${service.service_id}`, method='POST')
                                        .form-group
                                            label(for='edit_name') Название
                                            input#edit_name(type='text', name='name', value=service.name, required)
                                        .form-group
                                            label(for='edit_description') Описание
                                            input#edit_description(type='text', name='description', value=service.description, required)
                                        .form-group
                                            label(for='edit_price') Цена (руб.)
                                            input#edit_price(type='number', name='price', value=service.price, required, min='0')
                                        .form-group
                                            label(for='edit_duration_min') Длительность (мин.)
                                            input#edit_duration_min(type='number', name='duration_min', value=service.duration_min, required, min='10')
                                        
                                        button.button.primary(type='submit') Сохранить
                    else
                        tr
                            td(colspan='5') Услуги не найдены.